APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI -------------------------------------------------------------------
# The platform is fully functional with no key: objective marking runs in PHP,
# the tutor uses the on-device layer, and course generation declines and says
# why. A key switches on written marking, drafting, the live tutor and course
# writing. Check it with `php artisan ai:check`.
AI_DRIVER=openai
AI_MODEL=gpt-4o-mini
AI_TUTOR_MODEL=gpt-4o
AI_WRITER_MODEL=gpt-4o
AI_CONFIDENCE_FLOOR=80

# Marking: two calls must fit inside a 90s worker.
AI_TIMEOUT=35
# Writing one lesson is a much longer generation than marking one answer.
AI_WRITER_TIMEOUT=90
# How many practice questions a topic is stocked to, on demand.
AI_QUESTIONS_PER_TOPIC=10
# What a full bank looks like: how many questions `questions:generate` stocks
# one subject at one level to, divided across that offering's topics.
AI_QUESTIONS_PER_OFFERING=500

OPENAI_API_KEY=

# Alternative provider - set AI_DRIVER=claude and fill this to switch over.
# ANTHROPIC_API_KEY=

# Bulk sends space themselves by this.
MAIL_THROTTLE_PER_MINUTE=30
